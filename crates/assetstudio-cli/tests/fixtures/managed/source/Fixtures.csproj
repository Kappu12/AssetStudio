<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test fixtures for unity-typetree-gen. The UnityEngine stubs live in a
       separate referenced assembly, so their types are cross-assembly
       references — matching real games and exercising the generator's
       cross-assembly resolution. One class per type-tree test case. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Fixtures</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TestCases.cs" />
    <ProjectReference Include="UnityEngine/UnityEngine.csproj" />
  </ItemGroup>
</Project>
