<Project Sdk="Microsoft.NET.Sdk">
  <!-- Minimal UnityEngine stub assembly. Referenced by Fixtures so its types
       appear as cross-assembly references (as in a real game), exercising the
       generator's cross-assembly type resolution. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>UnityEngine</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <!-- Facade only: every type is forwarded to the module assembly. -->
  <ItemGroup>
    <ProjectReference Include="../UnityEngine.CoreModule/UnityEngine.CoreModule.csproj" />
  </ItemGroup>
</Project>
